# LOCAL version: GCS, Pub/Sub and BigQuery are emulated on disk (folders + SQLite).
# cp .env.local.example .env
DLH_ENV=local
# Emulation root: gcs/<bucket>/..., pubsub.sqlite, bigquery/<dataset>.sqlite
LOCAL_GCP_DIR=.local_gcp
# Just a folder name locally
GCS_BUCKET=dlh-lake

# --- Dukascopy (no token/API key needed: the historical datafeed is public) ---
DUKASCOPY_SYMBOLS=XAUUSD
# ticks and/or bars
DUKASCOPY_DATASETS=ticks,bars
# One bars_<tf> table per timeframe (pandas offset aliases), comma-separated
DUKASCOPY_BAR_TIMEFRAMES=1min,5min,15min,1h
# Where bars come from: ticks (24 hourly files/day)
# or candles (Dukascopy's BID+ASK 1-minute candle files: 2 requests/day, same OHLC/volume)
DUKASCOPY_BAR_SOURCE=ticks
# bid | ask | mid  (bid matches MT5 bars)
DUKASCOPY_BAR_PRICE_SIDE=bid
# What lands in Cloud Storage for BigQuery to load: csv | parquet
DUKASCOPY_LAKE_FORMAT=csv
# Also copy the raw .bi5 files to Cloud Storage (they always stay in {LOCAL_DATA_DIR}/raw)
DUKASCOPY_UPLOAD_RAW=false
# Price scale for symbols not in instruments.py, e.g. BTCUSD=10,USA500IDXUSD=1000
DUKASCOPY_POINT_OVERRIDES=
# Keep this low: Dukascopy rate-limits (HTTP 429) aggressive clients
DUKASCOPY_MAX_WORKERS=2
# Minimum seconds between any two requests, across all workers
DUKASCOPY_MIN_INTERVAL_S=0.5
# First wait after a 429 (doubles each retry, max 300s) when the server sends no Retry-After
DUKASCOPY_RATE_LIMIT_BACKOFF_S=30
# First wait after a 5xx/connection error (doubles each retry, max 120s)
DUKASCOPY_ERROR_BACKOFF_S=1
DUKASCOPY_MAX_RETRIES=5
DUKASCOPY_TIMEOUT_S=30

# Where downloads land before publishing: raw .bi5 -> {LOCAL_DATA_DIR}/raw, CSV -> {LOCAL_DATA_DIR}/csv
LOCAL_DATA_DIR=data

# --- Resource names (same in both versions) ---
PUBSUB_TOPIC=dukascopy-files
PUBSUB_SUBSCRIPTION=dukascopy-files-bq-loader
# Ticks go to this dataset; each bar timeframe gets its own: {BQ_DATASET}_1min, _5min, _15min, _1h
BQ_DATASET=market
GCS_PREFIX=dukascopy

# --- Backtest (python -m backtest) ---
# Results go to {BACKTEST_DATASET}.runs / .trades / .equity / .metrics
BACKTEST_DATASET=backtest
BACKTEST_INITIAL_CAPITAL=10000
# Fraction of equity lost when a stop is hit
BACKTEST_RISK_PER_TRADE=0.01
# Spread in points (1 point = 0.00001 EURUSD, 0.001 XAUUSD): 10 = 1 pip on EURUSD, 300 = $0.30 on gold
BACKTEST_SPREAD_POINTS=10
BACKTEST_SPREAD_OVERRIDES=XAUUSD=300
# Fraction of notional charged on entry and on exit
BACKTEST_COMMISSION_RATE=0
