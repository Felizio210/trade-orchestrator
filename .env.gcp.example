# GCP version: real Cloud Storage, Pub/Sub and BigQuery.
# cp .env.gcp.example .env
DLH_ENV=gcp
GCP_PROJECT=your-gcp-project-id
# Region for new buckets/datasets (asia-southeast2 = Jakarta). Keep GCS and BigQuery in the same one.
GCP_LOCATION=asia-southeast2
# Bucket names are global across all of GCP, so make it unique
GCS_BUCKET=your-project-dlh-lake

# Credentials: on GCP (Composer/VM/GKE) leave this unset and the attached service account
# is used. Elsewhere, point it at a service-account key, or run `gcloud auth application-default login`.
# The service account needs: Storage Object Admin (bucket), Pub/Sub Publisher + Subscriber,
# BigQuery Data Editor (dataset) + BigQuery Job User (project). `setup` also needs Pub/Sub Editor,
# BigQuery Data Owner/Admin and Storage Admin the first time, to create the resources.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# --- Dukascopy (no token/API key needed: the historical datafeed is public) ---
DUKASCOPY_SYMBOLS=XAUUSD
# ticks and/or bars
DUKASCOPY_DATASETS=ticks,bars
# One bars_<tf> table per timeframe (pandas offset aliases), comma-separated
DUKASCOPY_BAR_TIMEFRAMES=1min,5min,15min,1h
# Where bars come from for the CLI: ticks (24 hourly files/day)
# or candles (Dukascopy's BID+ASK 1-minute candle files: 2 requests/day, same OHLC/volume).
# The Airflow DAGs always use ticks: the hourly runs cache them, and finalize/repair reuse them.
DUKASCOPY_BAR_SOURCE=ticks
# bid | ask | mid  (bid matches MT5 bars)
DUKASCOPY_BAR_PRICE_SIDE=bid
# What lands in Cloud Storage for BigQuery to load: csv | parquet
DUKASCOPY_LAKE_FORMAT=csv
# Also copy the raw .bi5 files to Cloud Storage (they always stay in {LOCAL_DATA_DIR}/raw)
DUKASCOPY_UPLOAD_RAW=false
# Price scale for symbols not in instruments.py, e.g. BTCUSD=10,USA500IDXUSD=1000
DUKASCOPY_POINT_OVERRIDES=
# Keep this low: Dukascopy rate-limits (HTTP 429) aggressive clients
DUKASCOPY_MAX_WORKERS=2
# Minimum seconds between any two requests, across all workers
DUKASCOPY_MIN_INTERVAL_S=0.5
# First wait after a 429 (doubles each retry, max 300s) when the server sends no Retry-After
DUKASCOPY_RATE_LIMIT_BACKOFF_S=30
# First wait after a 5xx/connection error (doubles each retry, max 120s)
DUKASCOPY_ERROR_BACKOFF_S=1
DUKASCOPY_MAX_RETRIES=5
DUKASCOPY_TIMEOUT_S=30

# Where downloads land before publishing: raw .bi5 -> {LOCAL_DATA_DIR}/raw, CSV -> {LOCAL_DATA_DIR}/csv
LOCAL_DATA_DIR=data

# --- Resource names (same in both versions) ---
PUBSUB_TOPIC=dukascopy-files
PUBSUB_SUBSCRIPTION=dukascopy-files-bq-loader
# Ticks go to this dataset; each bar timeframe gets its own: {BQ_DATASET}_1min, _5min, _15min, _1h
BQ_DATASET=market
GCS_PREFIX=dukascopy

# --- Backtest (python -m backtest) ---
# Results go to {BACKTEST_DATASET}.runs / .trades / .equity / .metrics
BACKTEST_DATASET=backtest
BACKTEST_INITIAL_CAPITAL=10000
# Fraction of equity lost when a stop is hit
BACKTEST_RISK_PER_TRADE=0.01
# Spread in points (1 point = 0.00001 EURUSD, 0.001 XAUUSD): 10 = 1 pip on EURUSD, 300 = $0.30 on gold
BACKTEST_SPREAD_POINTS=10
BACKTEST_SPREAD_OVERRIDES=XAUUSD=300
# Fraction of notional charged on entry and on exit
BACKTEST_COMMISSION_RATE=0
# Metrics are also stored for the last N days of each run (scope "recent"), for TRADING_MIN_RECENT_RETURN
BACKTEST_RECENT_DAYS=90
# Walk-forward (the daily runs, and `backtest run` without --no-walk-forward): parameters are chosen
# from each strategy's GRID on TRAIN_DAYS, traded on the next TEST_DAYS, rolled forward; only those
# out-of-sample periods are stored (scope "oos"), and params_json is what the newest window chose
BACKTEST_WALK_FORWARD=true
BACKTEST_WF_TRAIN_DAYS=365
BACKTEST_WF_TEST_DAYS=90
# A parameter set needs this many trades in a training window to be chosen
BACKTEST_WF_MIN_TRADES=20
# A run still "running" after this many hours was killed; the next run marks it failed
BACKTEST_RUN_TIMEOUT_HOURS=3
# Equity curves stay bar by bar for the newest daily run of each strategy/timeframe and for runs
# younger than this; older ones are thinned to one row per day (backtest_daily's prune task)
BACKTEST_EQUITY_FULL_DAYS=7

# --- Gap repair (airflow/dags/dukascopy_repair.py, daily at 09:00 UTC) ---
# Backfills any missing day among the last N days up to yesterday
DUKASCOPY_REPAIR_DAYS=7
# After longer downtime the window stretches back to the newest day already in the lake,
# at most this many days (older gaps: python -m ingestion.dukascopy backfill)
DUKASCOPY_REPAIR_MAX_DAYS=60

# --- Freshness check (freshness task in airflow/dags/dukascopy_hourly.py) ---
# Fails when a symbol's newest bar (timeframes up to 1h) is more than N market-open hours old
DUKASCOPY_MAX_LAG_HOURS=2
# How many days back `python -m ops status` looks for days missing from the lake
DLH_HEALTH_LAKE_DAYS=14

# --- Backtest schedule (airflow/dags/backtest_daily.py, runs after each dukascopy_repair that leaves no gaps) ---
# strategy:timeframe pairs, one Airflow task each; default parameters
BACKTEST_DAILY_RUNS=supply_demand:1h,trendline:1h
# Each run covers this many days up to the run date
BACKTEST_DAILY_LOOKBACK_DAYS=730

# --- Trading (python -m trading; airflow/dags/trading_gate.py, trading_live.py, dukascopy_hourly.py) ---
# State goes to {TRADING_DATASET}_{TRADING_BROKER} (trading_paper, trading_dukascopy): one dataset per broker,
# so paper and broker trading never mix. Tables: approvals / signals / orders / positions / cursors / account / controls / events / drift
TRADING_DATASET=trading
# paper = simulated fills with the backtest's rules (sizing, spread, commission come from BACKTEST_*)
# dukascopy = a Dukascopy account through dlh-bridge (start bridge/run.sh first; see below)
TRADING_BROKER=paper
TRADING_PAPER_CAPITAL=10000
# Bars loaded before the new ones so indicators and zones warm up
TRADING_WARMUP_DAYS=60
# Only backtests whose run_id starts with this can approve a strategy (backtest_daily writes daily-...)
TRADING_RUN_PREFIX=daily-
# Approvals older than this are ignored (e.g. backtest_daily stopped running)
TRADING_APPROVAL_MAX_AGE_DAYS=3
# The standards, per strategy/timeframe/symbol, on its latest daily backtest. Empty = not checked.
TRADING_MIN_TRADES=50
TRADING_MIN_SHARPE=1.0
TRADING_MIN_PROFIT_FACTOR=1.3
# Largest drawdown allowed, as a fraction: 0.15 = -15%
TRADING_MAX_DRAWDOWN=0.15
TRADING_MIN_AVG_R=0.1
TRADING_MIN_WIN_RATE=
TRADING_MIN_RETURN=0
# The run's last BACKTEST_RECENT_DAYS must return at least this (empty = not checked)
TRADING_MIN_RECENT_RETURN=0
# Only approve on walk-forward (out-of-sample) backtests
TRADING_REQUIRE_OUT_OF_SAMPLE=true
# Risk limits. Open risk = sum of risk-to-stop of open positions and pending orders, fraction of balance.
TRADING_MAX_OPEN_POSITIONS=5
TRADING_MAX_OPEN_RISK=0.05
# Realized loss in one UTC day, fraction of that day's opening balance, that turns the kill switch on
TRADING_MAX_DAILY_LOSS=0.03
# Same-direction risk on one symbol across all strategies, fraction of balance (empty = no limit).
# 0.01 with BACKTEST_RISK_PER_TRADE=0.01: two strategies can't both be long gold at once
TRADING_MAX_SYMBOL_RISK=0.01
# Positions at the broker that this system didn't open always count toward the limits above
# How far back the live-vs-backtest comparison (trading.drift) looks
TRADING_DRIFT_DAYS=30

# --- Dukascopy account through dlh-bridge (bridge/run.sh), for TRADING_BROKER=dukascopy ---
# Where trading/brokers/dukascopy.py reaches the bridge, and the port the bridge listens on
TRADING_BRIDGE_URL=http://127.0.0.1:8765
TRADING_BRIDGE_PORT=8765
# JForex login (demo: from the registration email). Register this machine's IP on the account
# (Security > IP Registration), or Dukascopy asks for a PIN and the bridge can't log in.
DUKASCOPY_DEMO_USER=
DUKASCOPY_DEMO_PASSWORD=
# Empty = demo (https://platform.dukascopy.com/demo/jforex.jnlp)
DUKASCOPY_JNLP_URL=
# Instead of DUKASCOPY_DEMO_PASSWORD (leave that empty): bridge/run.sh reads the password from the
# macOS Keychain (service dlh-dukascopy, account DUKASCOPY_DEMO_USER), or from this GCP Secret Manager secret
DUKASCOPY_PASSWORD_SECRET=

# --- Alerts (ops/alerts.py): failed Airflow tasks, broker down/up, unknown positions, ops_daily summary ---
# Any number of channels; none = only logged. Test with: python -m ops alert-test
# Telegram: create a bot with @BotFather, send it a message, chat id from https://api.telegram.org/bot<token>/getUpdates
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
# Anything that takes POST {"text": ...}: Slack incoming webhook, Discord (.../slack), Mattermost
ALERT_WEBHOOK_URL=
# Email over SMTP (STARTTLS unless port 25)
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
# The same alert (e.g. one task failing every run) is sent at most once per this many minutes
ALERT_REPEAT_MINUTES=60

# --- Airflow (airflow/env.sh) ---
# Postgres metadata database, set by airflow/postgres_setup.sh: tasks run in parallel (LocalExecutor),
# so the trading step never waits behind a backtest. Empty = SQLite, one task at a time.
DLH_AIRFLOW_DB_URL=
DLH_AIRFLOW_PARALLELISM=4
